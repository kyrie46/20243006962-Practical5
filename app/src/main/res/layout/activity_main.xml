<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textViewAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/color_text_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewAppSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/color_text_dark"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imageViewMunicipalitiesMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/content_description_map"
            android:scaleType="fitCenter"
            android:src="@drawable/chinese_municipalities" />

        <TextView
            android:id="@+id/textViewInputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/editTextMunicipality"
            android:text="@string/main_input_label"
            android:textColor="@color/color_text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextMunicipality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/main_input_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/color_text_dark"
            android:textColorHint="@color/color_text_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewInputHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_input_helper"
            android:textColor="@color/color_text_dark"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
